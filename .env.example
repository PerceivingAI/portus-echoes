# PortusEchoes build-time curated models.
# Values are JSON arrays consumed during the build.
# Custom model inputs are added by the UI and are not included here.

# Local models: unique absolute HTTPS download path and GUI label.
LOCAL_MODELS='[{"downloadPath":"https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small-q8_0.bin","label":"Whisper Small Q8"},{"downloadPath":"https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-medium-q8_0.bin","label":"Whisper Medium Q8"}]'

# OpenAI models: API model ID, GUI label, and transport route.
# route must be exactly "completed" or "live".
OPENAI_MODELS='[{"id":"gpt-live-transcribe","label":"GPT Live Transcribe","route":"live"},{"id":"gpt-transcribe","label":"GPT Transcribe","route":"completed"}]'

# Groq models: API model ID, GUI label, and transport route.
# Current Groq standard models use completed-audio transcription.
GROQ_MODELS='[{"id":"whisper-large-v3-turbo","label":"Whisper Large V3 Turbo","route":"completed"},{"id":"whisper-large-v3","label":"Whisper Large V3","route":"completed"}]'

# Build-time provider language overrides ("auto" or ISO-639-1 code e.g. "fr", "en", "es").
# When set to "auto" or left blank, spoken language is automatically detected for every utterance.
LOCAL_LANGUAGE=auto
OPENAI_LANGUAGE=auto
GROQ_LANGUAGE=auto

# Local transcription segment delivery & chunk length.
# LOCAL_SEGMENT_DELIVERY: true = paste segments as they decode; false = wait for full VAD segment decode.
LOCAL_SEGMENT_DELIVERY=true
# LOCAL_MAX_LENGTH: maximum segment length in characters (0 = unconstrained natural Whisper segments; >0 = wrap at word boundaries).
LOCAL_MAX_LENGTH=10

# Cloud Live transcription recording limit in seconds (for gpt-live-transcribe / WebSocket route).
# 0 = unlimited / untimed (runs until key release or server timeout, like Local).
# >0 = maximum hold duration in seconds before automatically committing and finishing.
LIVE_RECORDING_LIMIT_SECS=1800
