{
  "name": "portus-echoes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:deps": "node scripts/bootstrap-whisper.mjs",
    "test:dependencies": "node --test scripts/bootstrap-whisper-tests.mjs",
    "dev": "npm run bootstrap:deps && vite",
    "check:error-routing": "node scripts/check-error-routing.mjs",
    "check:tauri-acl": "node scripts/check-tauri-acl.mjs",
    "build": "npm run bootstrap:deps && npm run check:error-routing && npm run check:tauri-acl && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "npm run test:dependencies && npm run check:error-routing && npm run check:tauri-acl && vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-store": "^2",
    "lucide-react": "^1.28.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "jsdom": "^25.0.1",
    "postcss": "^8",
    "tailwindcss": "^3",
    "tar": "^7.5.22",
    "typescript": "^5",
    "vite": "^5",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
