{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "onboarding",
  "description": "Least-privilege capabilities for the onboarding and Settings window.",
  "windows": ["onboarding"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "allow-get-settings",
    "allow-get-settings-navigation",
    "allow-select-active-provider",
    "allow-select-openai-model",
    "allow-select-openai-custom-model",
    "allow-set-openai-custom-model",
    "allow-select-groq-model",
    "allow-select-groq-custom-model",
    "allow-set-groq-custom-model",
    "allow-select-local-model",
    "allow-select-local-custom-model",
    "allow-set-local-custom-model-path",
    "allow-set-hotkey",
    "allow-focused-hotkey-key-event",
    "allow-set-hotkey-capture-active",
    "allow-reset-focused-hotkey-input",
    "allow-complete-onboarding",
    "allow-set-api-key",
    "allow-get-api-key",
    "allow-delete-api-key",
    "allow-get-provider-status",
    "allow-is-hotkey-registered",
    "allow-is-hotkey-active",
    "allow-run-diagnostics",
    "allow-get-diagnostics-state",
    "allow-list-local-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model"
  ]
}
